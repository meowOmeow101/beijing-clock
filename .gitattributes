# 默认按文本处理，仓库里统一存 LF；Windows 检出时由 git 自行决定
* text=auto

# 这些文件必须保持 LF，否则在类 Unix 系统上无法执行
*.sh text eol=lf
gradlew text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 图片与压缩包按二进制处理，不要做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.jks binary
*.apk binary
*.zip binary
